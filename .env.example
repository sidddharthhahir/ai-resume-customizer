# Database (MySQL 8+)
DATABASE_URL=mysql://user:password@localhost:3306/resume_customizer

# Session signing key — set a long random value in production
JWT_SECRET=change-me-in-production

# LLM provider: gemini | openai | anthropic
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional: override the default model for the selected provider
LLM_MODEL=
# Optional: point at an OpenAI-compatible endpoint instead of a built-in provider
LLM_BASE_URL=

# Local filesystem path for uploaded resumes/photos and generated files
STORAGE_DIR=./uploads

PORT=3000
NODE_ENV=development
